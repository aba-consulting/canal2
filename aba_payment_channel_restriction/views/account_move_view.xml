<odoo>
    <!-- Filtros por diario Canal 2 / normal en la vista de facturas -->
    <record id="aba_view_move_search_es_canal_2" model="ir.ui.view">
        <field name="name">account.move.search.es.canal.2</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <!-- Insertamos los filtros después del campo diario -->
            <field name="journal_id" position="after">
                <filter string="Canal 2" name="filter_canal_2"
                        domain="[('journal_id.es_canal_2', '=', True)]"/>
                <filter string="Facturas normales" name="filter_canal_normal"
                        domain="[('journal_id.es_canal_2', '=', False)]"/>
            </field>
        </field>
    </record>
</odoo>
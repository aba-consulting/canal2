<odoo>
    <!-- Aplicar dominio por available_canal_journal_ids en facturas de cliente -->
    <record id="aba_view_move_form_journal_domain" model="ir.ui.view">
        <field name="name">account.move.form.canal2.journal.domain</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Campo invisible necesario para que el dominio pueda referenciarlo -->
            <field name="journal_id" position="before">
                <field name="available_canal_journal_ids" invisible="1"/>
            </field>
            <!-- Solo restringir diario en facturas de cliente; para otros tipos el dominio original aplica -->
            <field name="journal_id" position="attributes">
                <attribute name="domain">[('id', 'in', available_canal_journal_ids)]</attribute>
            </field>
        </field>
    </record>

    <!-- Filtros por diario Canal 2 / normal en la vista de búsqueda de facturas -->
    <record id="aba_view_move_search_es_canal_2" model="ir.ui.view">
        <field name="name">account.move.search.es.canal.2</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <field name="journal_id" position="after">
                <filter string="Canal 2" name="filter_canal_2"
                        domain="[('journal_id.es_canal_2', '=', True)]"/>
                <filter string="Facturas normales" name="filter_canal_normal"
                        domain="[('journal_id.es_canal_2', '=', False)]"/>
            </field>
        </field>
    </record>

</odoo>